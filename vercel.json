{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "civora-server"
      }
    }
  ],
  "services": {
    "civora-server": {
      "root": ".",
      "buildCommand": "npm install"
    }
  }
}
