# Server
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/civora
CLIENT_URL=http://localhost:3000

# Better Auth (runs on Next.js client). Server only verifies JWTs.
# JWKS endpoint exposed by Better Auth JWT plugin, e.g. https://your-client.vercel.app/api/auth/jwks
BETTER_AUTH_JWKS_URL=
BETTER_AUTH_URL=http://localhost:3000
# Fallback HS256 secret for local dev if JWKS is not configured.
# Must match BETTER_AUTH_SECRET used by the Next.js app.
BETTER_AUTH_SECRET=dev-only-change-me-min-32-chars
JWT_ISSUER=civora
JWT_AUDIENCE=civora-client
